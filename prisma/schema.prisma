generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Favorite {
  id       String   @id @default(cuid())
  trackId  String   @unique
  title    String
  artist   String
  artwork  String?
  duration Int      @default(0)
  addedAt  DateTime @default(now())
}

model Playlist {
  id          String         @id @default(cuid())
  name        String
  description String?
  cover       String?
  items       PlaylistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  trackId    String
  title      String
  artist     String
  artwork    String?
  duration   Int      @default(0)
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  @@index([playlistId])
}

model HistoryEntry {
  id       String   @id @default(cuid())
  trackId  String
  title    String
  artist   String
  artwork  String?
  duration Int      @default(0)
  playedAt DateTime @default(now())

  @@index([playedAt])
}
