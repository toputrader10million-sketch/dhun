generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Lightweight device-sync user (no auth; identified by code or dhun_uid cookie)
model User {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String?
  createdAt    DateTime       @default(now())
  favorites    Favorite[]
  playlists    Playlist[]
  history      HistoryEntry[]
  queueHandoffs QueueHandoff[]
}

model Favorite {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   String   @default("yt")
  trackId  String
  title    String
  artist   String
  artwork  String?
  duration Int      @default(0)
  addedAt  DateTime @default(now())

  @@unique([source, trackId])
  @@index([userId])
}

model Playlist {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  cover       String?
  items       PlaylistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  source     String   @default("yt")
  trackId    String
  title      String
  artist     String
  artwork    String?
  duration   Int      @default(0)
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  @@index([playlistId])
}

model HistoryEntry {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   String   @default("yt")
  trackId  String
  title    String
  artist   String
  artwork  String?
  duration Int      @default(0)
  playedAt DateTime @default(now())

  @@index([playedAt])
  @@index([userId, playedAt])
}

// Cross-device queue handoff — a snapshot of the playing queue ("continue on
// another device"). items is a JSON array of QueuedTrack objects.
model QueueHandoff {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDevice String   @default("Unknown device")
  trackIndex Int      @default(0)
  position   Int      @default(0)
  shuffle    Boolean  @default(false)
  repeat     String   @default("off")
  items      String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
