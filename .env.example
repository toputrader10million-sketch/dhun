# ── Dhun — environment variables ────────────────────────────────────────────
# Copy to .env (local) or set in Vercel → Settings → Environment Variables.
# NEVER commit your real .env file.

# ── Database (REQUIRED) ─────────────────────────────────────────────────────
# Option A — Vercel / cloud production: Turso (libSQL)
#   1. turso db create music-player  (or use your existing db)
#   2. turso db show music-player --url        → TURSO_DATABASE_URL
#   3. turso db tokens create music-player     → TURSO_AUTH_TOKEN
# When both TURSO_* vars are set, the app uses Turso automatically (Prisma
# libSQL driver adapter). Otherwise it falls back to a local SQLite file.
TURSO_DATABASE_URL="libsql://music-player-<your-id>.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Option B — local development (SQLite file). Used when TURSO_* is absent.
DATABASE_URL="file:/absolute/path/to/project/db/custom.db"

# ── Notes ───────────────────────────────────────────────────────────────────
# - No other API keys are required: Piped, Audius, LRCLIB and iTunes are free
#   public APIs. YouTube playback uses the official (free) embedded player.
# - Push the schema to Turso once before first deploy:
#     DATABASE_URL="<TURSO_DATABASE_URL>?authToken=<TURSO_AUTH_TOKEN>" \
#       bunx prisma db push
#   (If the CLI refuses libsql:// URLs, generate SQL and apply it remotely:
#     bunx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > schema.sql
#     then run schema.sql against Turso with @libsql/client.)
